{
	"name": "@apt/task",
	"version": "0.6.1",
	"license": "MIT",
	"exports": {
		".": "./src/Task.ts",
		"./polyfill": "./src/polyfill/mod.ts"
	},
	"tasks": {
		"build": "rm -rf dist/* ; deno bundle --sourcemap=linked --minify --platform browser --code-splitting --outdir dist src/Task.ts",
		"test": "deno test",
		"test:watch": "deno test --watch"
	},
	"imports": {
		"@std/assert": "jsr:@std/assert@1"
	},
	"compilerOptions": {
		"lib": [
			"dom",
			"deno.ns"
		]
	},
	"fmt": {
		"useTabs": true
	},
	"test": {
		"include": ["src/**/*.test.ts"]
	},
	"lint": {
		"rules": {
			"exclude": [
				// we're extending Promise, which often
				// uses "any" in its type signatures.
				"no-explicit-any"
			]
		}
	}
}
